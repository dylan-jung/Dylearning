---
// English resume, AI Scientist framing. Same data as /resume/en, summary differs.
// 2026-09-06 LG AI Research AI Scientist 전환 면접에 이 버전으로 제출 — 이후 수정 금지(동결).
//   본문 데이터는 ./_data.ts, 템플릿은 components/resume/ResumeBody.astro를 공유하므로 그 두 파일도 함께 동결.
//   이후 수정은 새 경로로 복사해서 진행.
import ResumeBody from "../../../components/resume/ResumeBody.astro";
import * as d from "./_data";

const summary =
	"Specializes in LLM agents on both the model side (post-training data, evaluation) and the compute side (serving efficiency, execution infrastructure at scale): finds the bottleneck wherever it moves, from build I/O to KV cache to idle GPUs, and gets more out of the same hardware. Interested in algorithm-hardware co-design: designing model architectures around memory, bandwidth, and communication limits from the start, and aiming at research that designs models and compute together.";
---
<ResumeBody
  lang="en"
  header={d.header}
  summary={summary}
  sections={[
	{ title: "Work Experience", items: d.experience },
	{ title: "Projects", items: d.projects },
	{ title: "Education", items: d.education },
	{ title: "Activities", items: d.activities }
]}
  skills={d.skills}
  awards={d.awards}
  labels={{ summary: "Summary", skills: "Skills", awards: "Awards & Certifications", print: "Print to PDF" }}
  />
